<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.bigdata</groupId>
    <artifactId>script-box</artifactId>
    <version>1.0.0</version>
    <name>bigdata-script-box</name>
    <description>Lightweight shell script manager for FusionInsight bigdata nodes</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <node.version>v22.23.2</node.version>
        <!-- 执行 shell 脚本用的可执行文件。部署目标是 Linux，默认走 PATH 上的 bash。
             Windows 本地开发必须覆盖：C:\Windows\system32\bash.exe 是 WSL 转发器，
             会把 C:\Users\... 吞成 C:Users...，任何带路径的 bash 调用都会失败。
             用 `mvn -Pgit-bash test` 走 Git Bash 即可。 -->
        <scriptbox.shell-executable>bash</scriptbox.shell-executable>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Lombok: 减少 entity/dto/service 样板代码（@Data / @Builder / @Slf4j / @RequiredArgsConstructor 等）。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>script-box</finalName>
        <plugins>
            <!-- 1. Build the Vue 3 SPA via Vite.
                 Runs `npm install` (only if node_modules missing) and `npm run build`.
                 Skip with -DskipFrontend to bypass in offline environments. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <executable>npm</executable>
                            <arguments>
                                <argument>ci</argument>
                                <argument>--no-audit</argument>
                                <argument>--no-fund</argument>
                            </arguments>
                            <workingDirectory>frontend</workingDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <executable>npm</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                            <workingDirectory>frontend</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Copy frontend/dist/* into target/classes/static/ so Spring Boot serves it. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Standard Spring Boot fat-jar packaging. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JDK 17 + Mockito 5 inline mock maker requires self-attach.
                         file.encoding=UTF-8：中文 Windows 默认 ANSI 代码页会让 JVM 以
                         非 UTF-8 的 native encoding 启动，子进程（bash.exe）随之为管道/stdout
                         选择 UTF-16LE，落盘日志带 FF FE BOM，Files.readString 直接抛
                         MalformedInputException。钉死 UTF-8 消除这类平台差异。
                         scriptbox.shell-executable 让测试可以使用非 PATH 上的 shell
                         （Windows 上用 -Pgit-bash 覆盖；默认仍是 Linux 目标的 bash）。 -->
                    <argLine>-Xshare:off -Djdk.attach.allowAttachSelf=true -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8 -Dscriptbox.shell-executable=${scriptbox.shell-executable}</argLine>
                </configuration>
            </plugin>

            <!-- Lombok annotation processor: 在 compile 阶段生成 getter/setter 等字节码。
                 Spring Boot 3 的父 POM 已默认开启 annotationProcessorPaths，这里显式列出以稳定行为。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Use -DskipFrontend to build/test without invoking npm (e.g. CI offline). -->
        <profile>
            <id>no-frontend</id>
            <properties>
                <skipFrontend>true</skipFrontend>
            </properties>
        </profile>

        <!-- Windows 本地开发：用 Git Bash 跑测试与脚本执行。
             C:\Windows\system32\bash.exe（WSL 转发器）会吞掉 Windows 路径里的反斜杠，
             导致 bash -n <path> 与 bash <script.sh> 全部找不到文件。
             激活：mvn -Pgit-bash test
             注意 bash.exe 的默认路径含空格，而 Maven 的 <argLine> 无法安全传递带空格的
             -D 值（fork 出来的 JVM 会把它当成两个参数）。因此这里默认指向一个无空格的
             目录联接：mklink /J C:\gitbash "C:\Program Files\Git\bin"
             若 Git 装在别处且路径无空格，直接 -Dgit.bash.path=... 覆盖即可。 -->
        <profile>
            <id>git-bash</id>
            <properties>
                <git.bash.path>C:/gitbash/bash.exe</git.bash.path>
                <scriptbox.shell-executable>${git.bash.path}</scriptbox.shell-executable>
            </properties>
        </profile>
    </profiles>
</project>