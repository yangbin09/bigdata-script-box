# ============================================================
# BigData Script Box - .gitignore
# ============================================================

# --- Build outputs ---
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
.factorypath

# --- OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Maven ---
.mvn/
mvnw
mvnw.cmd

# ============================================================
# Runtime data — generated by the app on first launch.
# Never commit H2 database files, uploaded keytabs,
# user-uploaded script bodies, or execution logs.
# ============================================================

# H2 file-mode database
data/db/
*.mv.db
*.trace.db

# Uploaded keytabs (Kerberos credentials — SENSITIVE)
data/keytabs/
*.keytab

# User-managed script bodies
data/scripts/

# Execution logs / artifacts
data/executions/

# ============================================================
# Local overrides
# ============================================================
application-local.yml
application-local.yaml
*.local.yml
*.local.yaml
.env
.env.local

# Logs
*.log
logs/

# ============================================================
# Frontend (Vue 3 + Vite)
# ============================================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-error.log*